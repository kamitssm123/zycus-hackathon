# Copy to .env before the first `docker compose up`. Never commit .env.
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8080
WEB_PORT=3000
WEB_DEV_PORT=5173

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Frontend (build-time, must be prefixed VITE_)
VITE_APP_NAME=Hackathon App

# --- LLM gateway (Zycus LiteLLM, OpenAI-compatible) ---
LLM_BASE_URL=https://litellm-qc.zycus.net/v1
LLM_API_KEY=                     # <-- paste key here, never commit it
LLM_MODEL=gpt-5.6-luna-azure-payg-global
LLM_PRODUCT_HEADER=PC1
LLM_TIMEOUT_MS=8000
LLM_ENABLED=true                 # false -> deterministic stub, for offline demos

# --- Scheduling engine ---
SCHEDULING_STRATEGY=rule          # rule | ai  (also switchable at runtime via the admin endpoint)
SCHEDULING_HORIZON_DAYS=14
SCHEDULING_MAX_CANDIDATES=50
SCHEDULING_MAX_SUGGESTIONS=3
