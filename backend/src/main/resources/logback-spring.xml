<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- requestId comes from RequestIdFilter via MDC; it is the thread to pull on when debugging -->
      <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{requestId:-no-req-id}] %cyan(%logger{28}) - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
